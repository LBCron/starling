<Project Sdk="Microsoft.NET.Sdk">
  <!-- Out-of-tree probe: pass the repository with -p:Repo=<path>. Not part of AI.slnx. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestoreLockedMode>false</RestoreLockedMode>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(Repo)/ai-dotnet/src/Starlings.Models.Bert/Starlings.Models.Bert.csproj" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
  </ItemGroup>
</Project>
